# Optional development overrides. Do not put model credentials here.
# The installed application stores Reasonix authorization in its own local profile.
TAG_STORAGE=
TAG_CACHE=
TAG_PORT=8765
TAG_DISABLE_VISUAL_TAGGING=0
REASONIX_HOME=
REASONIX_EXE=
# Optional Amazon image collection proxies. Keep credentials outside tracked files.
AMAZON_SCRAPER_PROXY=
AMAZON_SCRAPER_PROXY_FILE=
